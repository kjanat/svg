{
	"$schema": "https://dprint.dev/schemas/v0.json",
	"extends": "https://cdn.jsdelivr.net/gh/kjanat/kjanat@master/configs/dprint.remote.json",
	"useTabs": true,
	"jsonSchemaSort": { "associations": ["**/schema.json", "**/*.schema.json"] },
	"json": {
		"trailingCommas": "maintain",
		"associations": ["**/*.json", "**/*.jsonc", "!crates/svg-data/data/**/*.json"]
	},
	"typescript": { "lineWidth": 150 },
	"markdown": { "textWrap": "always", "emphasisKind": "asterisks", "lineWidth": 80 },
	"markup": { "associations": ["!**/*.svg"] },
	"ruff": { "preview": true },
	"yaml": { "printWidth": 160 },
	"exec": {
		"cwd": "${configDir}",
		"cacheKey": "1",
		"timeout": 30,
		"commands": [
			{
				"command": "tombi format - --stdin-filename {{file_path}}",
				"exts": ["toml"],
				"cacheKeyFiles": ["tombi.toml"],
				"setupCommand": "node -e \"try { require('child_process').execSync('tombi --version', {stdio:'ignore'}); } catch { require('child_process').execSync('npm i -g tombi', {stdio:'inherit'}); }\"",
			},
			{
				"command": "rustfmt",
				"exts": ["rs"],
				"cacheKeyFiles": ["rustfmt.toml", ".cargo/config.toml", "rust-toolchain.toml"],
				"setupCommand": "node -e \"try { require('child_process').execSync('rustfmt --version', {stdio:'ignore'}); } catch { require('child_process').execSync('rustup component add rustfmt', {stdio:'inherit'}); }\"",
			},
			{
				"command": "just --dump --justfile {{file_path}}",
				"fileNames": ["justfile"],
				"setupCommand": "node -e \"try { require('child_process').execSync('just --version', {stdio:'ignore'}); } catch { require('child_process').execSync('npm i -g rust-just', {stdio:'inherit'}); }\"",
			},
			{ "command": "zig fmt --color off --stdin", "exts": ["zig"] },
			{ "command": "zig fmt --zon --color off --stdin", "exts": ["zon"] }
			// { "command": "cargo fmt-svg", "exts": ["svg"] },
		]
	},
	"excludes": [
		"crates/svg-language-server/assets/baseline-*.svg",
		"workers/svg-compat/static/badges/baseline-*.svg",
		"**/*.lock",
		"**/fixtures",
		"**/grammars/tree-sitter-*/**/w3/*.svg",
		"**/grammars/tree-sitter-*/src/*.json",
		"**/grammars/tree-sitter-*/test/**",
		"**/node_modules",
		"**/samples/w3",
		"**/svg-data/data/sources/**",
		"**/svgwg",
		"**/target",
		"**/zed-svg/grammars",
		"*.fixture.svg",
		".github/workflows/release.yml",
		"catalog.json",
		"single-page.html",
	],
	"plugins": [
		"npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67",
	],
}
