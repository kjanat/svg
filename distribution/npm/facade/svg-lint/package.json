{
	"name": "@svg-toolkit/svg-lint",
	"description": "Structural linter for SVG documents.",
	"keywords": [
		"svg",
		"lint",
		"linter",
		"cli",
		"diagnostics",
		"ansispeck"
	],
	"repository": "kjanat/svg",
	"funding": [{
		"type": "github",
		"url": "https://github.com/sponsors/kjanat"
	}],
	"type": "module",
	"imports": {
		"#launch": "./lib/launch.mjs",
		"#libc": "./lib/libc.mjs",
		"#pkg": "./package.json",
		"#resolve": "./lib/resolve.mjs"
	},
	"exports": {
		"./package.json": "./package.json",
		"./bin/*": "./bin/*"
	},
	"bin": "bin/svg-lint.mjs",
	"directories": {
		"lib": "./lib"
	},
	"files": [
		"bin/",
		"lib/",
		"README.md",
		"LICENSE"
	],
	"dependencies": {
		"ansispeck": "catalog:"
	},
	"optionalDependencies": {}
}
