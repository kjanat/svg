{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Baseline": {
      "description": "Baseline facts. A missing recognized status is never Limited availability.",
      "type": "object",
      "properties": {
        "high_date": {
          "description": "Optional milestone when the feature became Widely Available.",
          "anyOf": [
            {
              "$ref": "#/$defs/BaselineDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "low_date": {
          "description": "Optional milestone when the feature became Newly Available.",
          "anyOf": [
            {
              "$ref": "#/$defs/BaselineDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_status": {
          "description": "Original baseline field encoded as JSON, preserving null and invalid types.",
          "type": [
            "null",
            "string"
          ]
        },
        "status": {
          "description": "Recognized tier, independently of whether either date can be parsed.",
          "anyOf": [
            {
              "$ref": "#/$defs/BaselineTier"
            },
            {
              "type": "null"
            }
          ]
        },
        "status_diagnostic": {
          "description": "Parsing diagnostic, separate from the upstream status.",
          "anyOf": [
            {
              "$ref": "#/$defs/BaselineDiagnostic"
            },
            {
              "type": "null"
            }
          ]
        },
        "support": {
          "description": "Web Features browser versions for this selected status, independent of BCD support.",
          "type": [
            "null",
            "object"
          ],
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "BaselineDate": {
      "description": "A full upstream date, with a parsed value only when its meaning is recognized.",
      "type": "object",
      "required": [
        "raw"
      ],
      "properties": {
        "date": {
          "description": "Valid calendar date in YYYY-MM-DD form.",
          "type": [
            "null",
            "string"
          ]
        },
        "qualifier": {
          "description": "Recognized comparison qualifier; unknown prefixes are never approximated.",
          "anyOf": [
            {
              "$ref": "#/$defs/BaselineQualifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw": {
          "description": "Original upstream string, including any qualifier or malformed input.",
          "type": "string"
        }
      }
    },
    "BaselineDiagnostic": {
      "description": "Why an upstream status did not yield a recognized tier.",
      "oneOf": [
        {
          "description": "The status block has dates but no baseline field.",
          "type": "string",
          "const": "missing"
        },
        {
          "description": "The baseline field is present but not false, low, or high.",
          "type": "string",
          "const": "unrecognized"
        }
      ]
    },
    "BaselineQualifier": {
      "description": "Known inexactness qualifier on a date or browser version.",
      "oneOf": [
        {
          "description": "On or before the given date/version.",
          "type": "string",
          "const": "before"
        },
        {
          "description": "On or after the given date/version.",
          "type": "string",
          "const": "after"
        },
        {
          "description": "Approximately the given date/version.",
          "type": "string",
          "const": "approximately"
        }
      ]
    },
    "BaselineTier": {
      "description": "A recognized upstream Baseline tier, independent of dates and BCD flags.\n\nImported from Web Features, never calculated from the selected desktop\nbrowser rows. Missing/unrecognized status is `None`, not [`Self::Limited`].\nThis interoperability signal is separate from SVG validity and svg's usage\nrecommendations. See the [user guide](https://github.com/kjanat/svg/blob/master/docs/baseline.md)\nand [upstream definition](https://github.com/web-platform-dx/web-features/blob/main/docs/baseline.md).",
      "oneOf": [
        {
          "description": "Widely Available (`\"high\"` upstream): meets the longer-term upstream criteria.",
          "type": "string",
          "const": "widely"
        },
        {
          "description": "Newly Available (`\"low\"` upstream): reaches the upstream core browser set.",
          "type": "string",
          "const": "newly"
        },
        {
          "description": "Non-Baseline (`false` upstream), including discouraged features.",
          "type": "string",
          "const": "limited"
        }
      ]
    },
    "BrowserFlag": {
      "description": "A complete BCD flag declaration.",
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "description": "Flag or preference name.",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/FlagKind",
          "description": "Required upstream category."
        },
        "value_to_set": {
          "description": "Required setting value, if supplied.",
          "type": [
            "null",
            "string"
          ]
        }
      }
    },
    "BrowserVersion": {
      "description": "One complete support statement. Collections normalize upstream singleton/array forms.",
      "type": "object",
      "properties": {
        "alternative_name": {
          "description": "Name used by this implementation.",
          "type": [
            "null",
            "string"
          ]
        },
        "flags": {
          "description": "All flag declarations.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/BrowserFlag"
          }
        },
        "impl_url": {
          "description": "Implementation tracking links.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "description": "Original upstream notes, with HTML retained as data.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "partial_implementation": {
          "description": "Whether mandatory behavior is missing.",
          "default": false,
          "type": "boolean"
        },
        "prefix": {
          "description": "Required prefix.",
          "type": [
            "null",
            "string"
          ]
        },
        "version_added": {
          "description": "Upstream version union. Absent/null/invalid input remains unknown.",
          "anyOf": [
            {
              "$ref": "#/$defs/VersionAdded"
            },
            {
              "type": "null"
            }
          ]
        },
        "version_last": {
          "description": "Last version with support.",
          "type": [
            "null",
            "string"
          ]
        },
        "version_removed": {
          "description": "First version without support, retaining its qualifier.",
          "type": [
            "null",
            "string"
          ]
        }
      }
    },
    "CatalogCompatSubfeature": {
      "description": "A BCD feature below an SVG element that is not an element or attribute.",
      "type": "object",
      "required": [
        "compat_key",
        "element",
        "kind",
        "name"
      ],
      "properties": {
        "baseline": {
          "description": "Web-platform baseline status, when known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Baseline"
            },
            {
              "type": "null"
            }
          ]
        },
        "browser_support": {
          "description": "Per-browser support data, when known.",
          "type": [
            "null",
            "object"
          ],
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/BrowserVersion"
            }
          }
        },
        "compat_key": {
          "description": "Full BCD compat key, e.g. `svg.elements.use.data_uri`.",
          "type": "string"
        },
        "deprecated": {
          "description": "Whether compat data marks the feature deprecated.",
          "type": "boolean"
        },
        "discouraged": {
          "description": "`WebDX` discouragement, retaining feature identity and compatibility context.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Discouraged"
          }
        },
        "element": {
          "description": "Owning SVG element name.",
          "type": "string"
        },
        "experimental": {
          "description": "Whether compat data marks the feature experimental.",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/CatalogCompatSubfeatureKind",
          "description": "Why this was not modeled as a normal attribute/element."
        },
        "mdn_url": {
          "description": "MDN reference URL.",
          "type": [
            "null",
            "string"
          ]
        },
        "name": {
          "description": "BCD child feature name.",
          "type": "string"
        },
        "standard_track": {
          "description": "Whether compat data marks the feature as standards-track.",
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "CatalogCompatSubfeatureKind": {
      "description": "Why a BCD child feature is kept out of the attribute catalog.",
      "oneOf": [
        {
          "description": "A behavior or value-shape feature, not an attribute name.",
          "type": "string",
          "const": "behavior"
        },
        {
          "description": "A legacy `xlink:*` alias that needs profile-scoped alias modeling.",
          "type": "string",
          "const": "legacy_xlink_alias"
        }
      ]
    },
    "CatalogPackageSource": {
      "description": "One npm package source used during regeneration.",
      "type": "object",
      "required": [
        "name",
        "url",
        "version"
      ],
      "properties": {
        "name": {
          "description": "Package name.",
          "type": "string"
        },
        "url": {
          "description": "Exact data URL fetched.",
          "type": "string"
        },
        "version": {
          "description": "Resolved package version.",
          "type": "string"
        }
      }
    },
    "Discouraged": {
      "description": "Feature-scoped `WebDX` discouragement; independent of Baseline and BCD deprecation.",
      "type": "object",
      "required": [
        "according_to",
        "alternatives",
        "compat_key",
        "feature_id",
        "reason",
        "scope"
      ],
      "properties": {
        "according_to": {
          "description": "Supporting specification or vendor notices.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alternatives": {
          "description": "Alternative Web Features identifiers.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compat_key": {
          "description": "BCD compatibility key through which this feature applies.",
          "type": "string"
        },
        "feature_id": {
          "description": "Web Features identity, including when facts are aggregated across SVG contexts.",
          "type": "string"
        },
        "feature_name": {
          "description": "Human-readable feature name when provided upstream.",
          "type": [
            "null",
            "string"
          ]
        },
        "reason": {
          "description": "Upstream explanation, rendered as text.",
          "type": "string"
        },
        "reason_html": {
          "description": "Original HTML explanation, retained for consumers but not rendered as trusted HTML.",
          "type": [
            "null",
            "string"
          ]
        },
        "removal_date": {
          "description": "Optional upstream removal date; no inferred removal policy.",
          "type": [
            "null",
            "string"
          ]
        },
        "scope": {
          "$ref": "#/$defs/DiscouragementScope",
          "description": "Scope of the advice (always the whole Web Features feature)."
        }
      }
    },
    "DiscouragementScope": {
      "description": "Scope of `WebDX` discouragement metadata.",
      "oneOf": [
        {
          "description": "Advice applies to the named Web Features feature.",
          "type": "string",
          "const": "feature"
        }
      ]
    },
    "FlagKind": {
      "description": "BCD's two flag categories.",
      "oneOf": [
        {
          "description": "A browser preference.",
          "type": "string",
          "const": "preference"
        },
        {
          "description": "A command-line/runtime flag.",
          "type": "string",
          "const": "runtime_flag"
        }
      ]
    },
    "Unsupported": {
      "type": "boolean",
      "const": false
    },
    "VersionAdded": {
      "description": "BCD's `string | false` version value, including qualified versions and `preview`.",
      "anyOf": [
        {
          "description": "Original version string.",
          "type": "string"
        },
        {
          "$ref": "#/$defs/Unsupported",
          "description": "Explicitly unsupported."
        }
      ]
    }
  },
  "title": "svg-data compat catalog v2",
  "description": "Browser-compat provenance and retained non-catalogued compat features.",
  "type": "object",
  "required": [
    "browser_compat_data",
    "schema_version",
    "web_features"
  ],
  "properties": {
    "browser_compat_data": {
      "$ref": "#/$defs/CatalogPackageSource",
      "description": "MDN browser-compat-data package source."
    },
    "schema_version": {
      "const": 2
    },
    "unmodeled_features": {
      "description": "BCD features intentionally not modeled as elements/attributes.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/CatalogCompatSubfeature"
      }
    },
    "web_features": {
      "$ref": "#/$defs/CatalogPackageSource",
      "description": "web-features package source."
    }
  }
}
