{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended"
	],
	"timezone": "Europe/Amsterdam",
	"schedule": ["* * * * 1"],
	"minimumReleaseAge": "24 hours",
	"customManagers": [
		{
			"customType": "regex",
			"description": "Track the Bun catalog range used by the grammar packages alongside the root formatter pins.",
			"managerFilePatterns": ["/^package\\.json$/"],
			"matchStrings": ["\"@kprint/kprint\"\\s*:\\s*\"(?<currentValue>\\^[^\"\\s]+)\""],
			"depNameTemplate": "@kprint/kprint",
			"datasourceTemplate": "npm",
			"versioningTemplate": "npm"
		},
		{
			"customType": "regex",
			"description": "Python targets for Pyright and ty.",
			"managerFilePatterns": ["/^pyproject\\.toml$/"],
			"matchStrings": ["(?:pythonVersion|python-version)\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+)\""],
			"depNameTemplate": "python",
			"datasourceTemplate": "python-version"
		},
		{
			"customType": "regex",
			"description": "Ruff's compact Python target.",
			"managerFilePatterns": ["/^pyproject\\.toml$/"],
			"matchStrings": ["target-version\\s*=\\s*\"py(?<currentValue>(?<major>\\d)(?<minor>\\d+))\""],
			"currentValueTemplate": "{{{major}}}.{{{minor}}}",
			"autoReplaceStringTemplate": "target-version = \"py{{{replace '\\.' '' newValue}}}\"",
			"depNameTemplate": "python",
			"datasourceTemplate": "python-version"
		},
		{
			"customType": "regex",
			"description": "Python wheel build selectors for every SVG grammar.",
			"managerFilePatterns": ["/^grammars\\/tree-sitter-svg(?:-[^/]+)?\\/pyproject\\.toml$/"],
			"matchStrings": ["build\\s*=\\s*\"cp(?<currentValue>(?<major>\\d)(?<minor>\\d+))-\\*\""],
			"currentValueTemplate": "{{{major}}}.{{{minor}}}",
			"autoReplaceStringTemplate": "build = \"cp{{{replace '\\.' '' newValue}}}-*\"",
			"depNameTemplate": "python",
			"datasourceTemplate": "python-version"
		}
	],
	"packageRules": [
		{
			"matchDatasources": ["crate"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "Rust dependencies",
			"groupSlug": "rust-dependencies"
		},
		{
			"matchDatasources": ["npm", "node-version"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "JavaScript tooling",
			"groupSlug": "javascript-tooling"
		},
		{
			"matchDatasources": ["pypi"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "Python tooling",
			"groupSlug": "python-tooling"
		},
		{
			"matchDatasources": ["maven"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "Java tooling",
			"groupSlug": "java-tooling"
		},
		{
			"matchPackageNames": ["@kjanat/fmt", "@kprint/kprint"],
			"rangeStrategy": "bump",
			"groupName": "kprint",
			"groupSlug": "kprint",
			"separateMajorMinor": false
		},
		{
			"matchPackageNames": [
				"tree-sitter",
				"tree-sitter-cli",
				"tree-sitter-language",
				"github.com/tree-sitter/go-tree-sitter",
				"tree-sitter/swift-tree-sitter",
				"io.github.tree-sitter:jtreesitter"
			],
			"groupName": "Tree-sitter runtime and bindings",
			"groupSlug": "tree-sitter"
		},
		{
			"description": "No update PRs for GitHub Actions.",
			"matchManagers": ["github-actions"],
			"enabled": false
		},
		{
			"description": "Use Python releases for the interpreter pin, matching the package minimums and tool targets.",
			"matchManagers": ["pyenv"],
			"matchPackageNames": ["python"],
			"overrideDatasource": "python-version"
		},
		{
			"description": "Update the interpreter, package minimums, analysis targets, wheel selectors, and uv lockfile together.",
			"matchDatasources": ["python-version"],
			"matchPackageNames": ["python"],
			"extractVersion": "^(?<version>\\d+\\.\\d+)(?:\\.\\d+)?$",
			"versioning": "pep440",
			"rangeStrategy": "bump",
			"groupName": "Python",
			"groupSlug": "python",
			"separateMajorMinor": false,
			"separateMinorPatch": false
		}
	]
}
