{
	"$schema": "https://cdn.jsdelivr.net/gh/denoland/deno@refs/heads/main/cli/schemas/config-file.v1.json",
	"workspace": {
		"members": ["./workers/*"],
	},
	"importMap": "./import_map.json",
	"lock": false,
	"fmt": { "exclude": ["**"] },
	"tasks": {
		"check:deploy": "deno task --config workers/svg-compat/deno.jsonc check:deploy",
		"dev:all": "deno task --recursive dev",
		"fmt": {
			"command": "dprint fmt",
			"description": "Format the codebase using dprint.",
		},
	},
	// Deploy's build machine has 1024 MiB. Its build only verifies the assets;
	// the worker tests (`deno task check:deploy`) run in GitHub CI, because they
	// exceed that limit there. DENO_NO_PACKAGE_JSON keeps the Bun workspace's
	// dev tooling (~300 MB: Biome, dprint, tree-sitter, ...) out of the install:
	// the worker resolves its npm packages through import_map.json.
	"deploy": {
		"org": "kjanat",
		"app": "svg-compat",
		"install": "DENO_NO_PACKAGE_JSON=1 deno install",
		"build": "DENO_NO_PACKAGE_JSON=1 deno run --allow-read scripts/baseline-icons.ts --check",
		"runtime": { "entrypoint": "main.ts", "cwd": "workers/svg-compat/src" },
	},
	"exclude": ["./target", "./grammars"],
	"lint": {
		"rules": {
			"tags": ["recommended", "workspace"],
		},
	},
	"compilerOptions": { "checkJs": true, "strict": true },
	"nodeModulesDir": "none",
}
